# Google Gemini API Key (Get one free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Brain Model (gemini-3.8-flash or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Text-To-Speech Engine ("gemini" for expressive stage directions, or "edge" for offline neural voice)
TTS_ENGINE=gemini
# Gemini Expressive Voice Model (gemini-3.8-flash-lite-tts or gemini-3.8-flash-tts)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Locked Voice Identity (Puck = mischievous/raspy skeleton; Charon = deep/crypt; Fenrir = gravelly)
GEMINI_VOICE_NAME=Puck

# Hardware Configuration
CAMERA_INDEX=0
# Optional: specify microphone device index or name (leave blank for system default)
AUDIO_INPUT_DEVICE=

# Voice Activity Detection (VAD) Tuning
VAD_ENERGY_THRESHOLD=0.03
SILENCE_DURATION_SEC=1.2
MAX_RECORDING_SEC=15.0

# Edge-TTS Fallback Settings (used if TTS_ENGINE=edge or if Gemini TTS is unavailable)
TTS_VOICE=en-US-ChristopherNeural
TTS_PITCH=-15Hz
TTS_RATE=-5%

# Spooky Audio FX (requires ffmpeg)
# Adds crypt reverb/echo and hollow bass resonance
ENABLE_SPOOKY_FX=true

# ---------------------------------------------------------------------------
# Conversation engine: "live" (Gemini Live API, streaming, ~1s replies) or "classic"
ENGINE=live
GEMINI_LIVE_MODEL=gemini-3.8-live
# Live voice (deepest measured: Alnilam, Gacrux, Umbriel, Algenib). Classic engine still uses GEMINI_VOICE_NAME.
LIVE_VOICE_NAME=Algenib
# Real-time voice FX (when ENABLE_SPOOKY_FX=true): pitch shift in semitones (negative = deeper, 0 = off)
LIVE_PITCH_SEMITONES=-3
# Echo: time between repeats, how much each repeat keeps (0-0.9), and loudness (0 = no echo)
LIVE_ECHO_DELAY_MS=220
LIVE_ECHO_FEEDBACK=0.35
LIVE_ECHO_MIX=0.2
# Camera frames streamed to Live while a visitor is talking (max 1 fps)
LIVE_VIDEO_FPS=1.0
LIVE_VIDEO_MAX_DIM=768
# Seconds of quiet before the session closes and memory resets for the next visitor
LIVE_IDLE_TIMEOUT_SEC=25
# Silence (ms) the server waits for before treating the visitor's turn as finished
LIVE_END_SILENCE_MS=800
# Mic stays muted this long after Bonesy stops talking (covers Bluetooth delay + echo)
LIVE_ECHO_TAIL_SEC=1.2
# Let visitors interrupt Bonesy mid-sentence (only if the mic can't hear the skeleton's speaker)
LIVE_BARGE_IN=false
# Default language (BCP-47); Bonesy only switches if a visitor clearly speaks another language
LIVE_LANGUAGE=en-US
# Faint noise played between replies so the Bluetooth speaker doesn't clip first words (0 = off)
LIVE_KEEPALIVE_LEVEL=0.001

# ---------------------------------------------------------------------------
# Ultra Skelly (Home Depot 6.5 ft) over Bluetooth
SKELLY_BLE_ENABLED=true
# Optional: skip scanning (macOS shows a UUID here; find it with: python3 skelly_ble.py scan)
SKELLY_BLE_ADDRESS=
# Optional: name hint if you renamed the skeleton in the app
SKELLY_BLE_NAME=
# Optional: skeleton speaker volume 0-255, set at startup
SKELLY_VOLUME=
# Voice output device (substring match); pair "Ultra Skelly v2(Live)" with PIN 1234
SKELLY_AUDIO_OUTPUT=Skelly
