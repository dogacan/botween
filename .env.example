# Google Gemini API Key (Get one free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (gemini-3.5-flash-lite, gemini-3.6-flash, or gemini-flash-lite-latest)
GEMINI_MODEL=gemini-3.5-flash-lite

# Hardware Configuration
CAMERA_INDEX=0
# Optional: specify microphone device index or name (leave blank for system default)
AUDIO_INPUT_DEVICE=

# Voice Activity Detection (VAD) Tuning
VAD_ENERGY_THRESHOLD=0.03
SILENCE_DURATION_SEC=1.2
MAX_RECORDING_SEC=15.0

# Text-To-Speech & Spooky Voice Settings
# Good male voices: en-US-ChristopherNeural, en-US-GuyNeural, en-GB-RyanNeural
# Good female voices: en-US-JennyNeural, en-GB-SoniaNeural
TTS_VOICE=en-US-ChristopherNeural
TTS_PITCH=-15Hz
TTS_RATE=-5%

# Audio FX (requires ffmpeg)
# Adds crypt reverb/echo and hollow bass resonance
ENABLE_SPOOKY_FX=true
