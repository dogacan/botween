# Google Gemini API Key (Get one free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Brain Model (gemini-3.8-flash or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Text-To-Speech Engine ("gemini" for expressive stage directions, or "edge" for offline neural voice)
TTS_ENGINE=gemini
# Gemini Expressive Voice Model (gemini-3.8-flash-lite-tts or gemini-3.8-flash-tts)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Locked Voice Identity (Puck = mischievous/raspy skeleton; Charon = deep/crypt; Fenrir = gravelly)
GEMINI_VOICE_NAME=Puck

# Hardware Configuration
CAMERA_INDEX=0
# Optional: specify microphone device index or name (leave blank for system default)
AUDIO_INPUT_DEVICE=

# Voice Activity Detection (VAD) Tuning
VAD_ENERGY_THRESHOLD=0.03
SILENCE_DURATION_SEC=1.2
MAX_RECORDING_SEC=15.0

# Edge-TTS Fallback Settings (used if TTS_ENGINE=edge or if Gemini TTS is unavailable)
TTS_VOICE=en-US-ChristopherNeural
TTS_PITCH=-15Hz
TTS_RATE=-5%

# Spooky Audio FX (requires ffmpeg)
# Adds crypt reverb/echo and hollow bass resonance
ENABLE_SPOOKY_FX=true
