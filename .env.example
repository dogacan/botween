# Google Gemini API Key (Get one free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Brain Model (gemini-3.8-flash or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Text-To-Speech Engine ("gemini" for expressive stage directions, or "edge" for offline neural voice)
TTS_ENGINE=gemini
# Gemini Expressive Voice Model (gemini-3.8-flash-lite-tts or gemini-3.8-flash-tts)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Locked Voice Identity (Puck = mischievous/raspy skeleton; Charon = deep/crypt; Fenrir = gravelly)
GEMINI_VOICE_NAME=Puck

# Hardware Configuration
# Camera and microphone: a name (word match) or an index. See what's connected with:
#   python3 devices.py
CAMERA_DEVICE=USB Camera
# Blank = system default mic. "USB Camera" also matches its "USB 2.0 Camera" mic.
MIC_DEVICE=USB Camera
# Rotate the camera picture 180° (for an upside-down mount)
CAMERA_ROTATE_180=false

# Voice Activity Detection (VAD) Tuning
VAD_ENERGY_THRESHOLD=0.03
SILENCE_DURATION_SEC=1.2
MAX_RECORDING_SEC=15.0

# Edge-TTS Fallback Settings (used if TTS_ENGINE=edge or if Gemini TTS is unavailable)
TTS_VOICE=en-US-ChristopherNeural
TTS_PITCH=-15Hz
TTS_RATE=-5%

# Spooky Audio FX (requires ffmpeg)
# Adds crypt reverb/echo and hollow bass resonance
ENABLE_SPOOKY_FX=true

# ---------------------------------------------------------------------------
# Conversation engine: "live" (Gemini Live API, streaming, ~1s replies) or "classic"
ENGINE=live
GEMINI_LIVE_MODEL=gemini-3.8-live
# Live voice (deepest measured: Alnilam, Gacrux, Umbriel, Algenib). Classic engine still uses GEMINI_VOICE_NAME.
LIVE_VOICE_NAME=Algenib
# Real-time voice FX (when ENABLE_SPOOKY_FX=true): pitch shift in semitones (negative = deeper, 0 = off)
LIVE_PITCH_SEMITONES=-3
# Echo: time between repeats, how much each repeat keeps (0-0.9), and loudness (0 = no echo)
LIVE_ECHO_DELAY_MS=220
LIVE_ECHO_FEEDBACK=0.35
LIVE_ECHO_MIX=0.2
# Camera frames sent to Live during a conversation: at most one every this many seconds
# (a fresh frame also goes out when a visitor walks up or starts talking)
LIVE_VIDEO_INTERVAL_SEC=5
LIVE_VIDEO_MAX_DIM=768
# Seconds of quiet before the session closes and memory resets for the next visitor
LIVE_IDLE_TIMEOUT_SEC=25
# Hard limits per visitor session (prevents porch loitering and multi-turn jailbreaks)
LIVE_MAX_TURNS=6
LIVE_MAX_SESSION_SEC=90
# After a cap goodbye, ignore the mic this long so the same group can't restart right away
LIVE_CAP_COOLDOWN_SEC=5
# Content filter level for both engines: BLOCK_LOW_AND_ABOVE, BLOCK_MEDIUM_AND_ABOVE or BLOCK_ONLY_HIGH
# (LOW flags ordinary spooky talk like graves and zombies)
SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
# Silence (ms) the server waits for before treating the visitor's turn as finished
LIVE_END_SILENCE_MS=800
# Mic stays muted this long after Bonesy stops talking (covers Bluetooth delay + echo)
LIVE_ECHO_TAIL_SEC=1.2
# Let visitors interrupt Bonesy mid-sentence (only if the mic can't hear the skeleton's speaker)
LIVE_BARGE_IN=false
# Save each conversation (transcripts, cues and every frame sent to Gemini) for replay.py.
# Off by default because the frames are pictures of visitors, often kids.
RECORD_SESSIONS=false
RECORD_DIR=recordings
# Say an awakening line at startup (off: motion detection greets visitors anyway)
STARTUP_GREETING=false
# Default language (BCP-47); Bonesy only switches if a visitor clearly speaks another language
LIVE_LANGUAGE=en-US
# Faint noise played between replies so the Bluetooth speaker doesn't clip first words (0 = off)
LIVE_KEEPALIVE_LEVEL=0.001

# ---------------------------------------------------------------------------
# Camera motion trigger (live engine, auto mode): Bonesy greets visitors as they walk up
MOTION_ENABLED=true
# Share of the frame (0-1) that must move to count as a person; raise it if passers-by trigger him
MOTION_MIN_AREA=0.03
# If more than this changes at once it's headlights, a porch light or camera shake, so it's ignored
MOTION_MAX_AREA=0.5
# Motion must last this many seconds
MOTION_SUSTAIN_SEC=0.5
# After a visitor, watch again once the porch has been still this long...
MOTION_REARM_QUIET_SEC=3
# ...or this long after the last conversation (for a steady line of kids)
MOTION_REARM_MAX_SEC=30
# Close a motion-started conversation this long after Bonesy's line if the visitor never talks
MOTION_SILENT_TIMEOUT_SEC=10
# If a visitor is still in view but quiet this long after Bonesy's line, he tells one joke (0 = off)
MOTION_JOKE_AFTER_SEC=6
# Optional area to watch, as fractions of the frame: x,y,width,height (e.g. 0.2,0.3,0.6,0.7)
MOTION_ROI=

# ---------------------------------------------------------------------------
# Ultra Skelly (Home Depot 6.5 ft) over Bluetooth
SKELLY_BLE_ENABLED=true
# Optional: skip scanning (macOS shows a UUID here; find it with: python3 skelly_ble.py scan)
SKELLY_BLE_ADDRESS=
# Optional: name hint if you renamed the skeleton in the app
SKELLY_BLE_NAME=
# Optional: skeleton speaker volume 0-255, set at startup
SKELLY_VOLUME=
# Body parts that move once a visitor has spoken in a conversation (head, arm, torso, all or none).
# Gemini's 'move' tool is limited to these. Torso is left out because it shakes the camera view.
SKELLY_MOVEMENT=head,arm
# Body parts that may move until a visitor speaks: between visitors, during the startup greeting and when
# greeting someone who walked up. Anything that moves here can set off motion detection.
SKELLY_IDLE_MOVEMENT=head
# Voice output device (substring match); pair "Ultra Skelly v2(Live)" with PIN 1234
SKELLY_AUDIO_OUTPUT=Skelly

# Jokes: how many random jokes from jokes.json Bonesy gets for each visitor
JOKES_PER_SESSION=5
